#!/bin/bash
# push の前にテストを走らせ、失敗したら push を止める (2026-10-16)。
# 有効化: git config core.hooksPath .githooks (クローンし直したら 1 回実行)
# 緊急時のバイパス: SKIP_TESTS=1 git push ... (人間用)
#
# TEST_DIRS: "リポの一番上からの場所:pytest に渡す引数"。push する変更がその場所に
# 無ければ飛ばす ("." はどの変更でも走らせる)。場所に .venv があればその python を使う。
TEST_DIRS=(".:")

if [ "$SKIP_TESTS" = "1" ]; then
  exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 1

ZERO=0000000000000000000000000000000000000000
changed=""
all=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue  # ブランチの削除
  if [ "$rsha" = "$ZERO" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    all=1  # 新しいブランチ・相手の版が手元に無い → 全部走らせる
    continue
  fi
  changed+="$(git diff --name-only "$rsha" "$lsha")"$'\n'
done
if [ "$all" = 0 ] && [ -z "${changed//$'\n'/}" ]; then
  exit 0
fi

log=$(mktemp)
trap 'rm -f "$log"' EXIT
fail=0
for entry in "${TEST_DIRS[@]}"; do
  dir=${entry%%:*}
  args=${entry#*:}
  if [ "$all" = 0 ] && [ "$dir" != "." ] && ! grep -q "^$dir/" <<<"$changed"; then
    continue
  fi
  py=python3
  [ -x "$dir/.venv/bin/python" ] && py=.venv/bin/python
  # shellcheck disable=SC2086
  if (cd "$dir" && "$py" -m pytest -q -p no:cacheprovider $args) </dev/null >"$log" 2>&1; then
    echo "pre-push: テスト OK ($dir) $(tail -n 1 "$log")" >&2
  else
    echo "" >&2
    echo "=== pre-push: テスト失敗 ($dir) ===" >&2
    tail -n 40 "$log" >&2
    fail=1
  fi
done

if [ "$fail" = 1 ]; then
  echo "" >&2
  echo "テストを直してから push してください。(緊急時: SKIP_TESTS=1 git push ...)" >&2
  exit 1
fi
